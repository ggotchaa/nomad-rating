NODE_ENV=development
HOST=127.0.0.1
PORT=3010
DATABASE_URL=postgres://nomad:nomad@127.0.0.1:5433/nomad
# Leave empty to use the in-process event bus (single server process, no worker).
REDIS_URL=redis://127.0.0.1:6380
SESSION_DAYS=30
# Public site URL (links in notifications, OG previews)
SITE_URL=http://localhost:5173
# Demo mode: «Войти как…» switcher, demo banner, /api/demo routes. Never enable in production.
DEMO_MODE=true
