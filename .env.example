NODE_ENV=development
HOST=127.0.0.1
PORT=3010
DATABASE_URL=postgres://nomad:nomad@127.0.0.1:5433/nomad
# Leave empty to use the in-process event bus (single server process, no worker).
REDIS_URL=redis://127.0.0.1:6380
SESSION_DAYS=30
# Public site URL (links in notifications, OG previews)
SITE_URL=http://localhost:5173
# Mail over SMTP (smtp://user:pass@host:587). Empty: e-mails are printed to the server console.
SMTP_URL=
MAIL_FROM=Nomad <no-reply@nomad.kz>
# Google sign-in is enabled only when both are set. Redirect URI defaults to SITE_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Require TOTP 2FA for platform admins.
ADMIN_2FA_REQUIRED=false
# Local storage for uploaded photos (served at /api/uploads).
UPLOADS_DIR=uploads
# Web Push (VAPID). Generate: npx web-push generate-vapid-keys. Push is disabled while empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@nomad.kz
# Telegram bot (grammY). The bot and Telegram delivery are disabled while empty.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=nomad_amateur_bot
